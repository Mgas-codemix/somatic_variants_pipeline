/*
 * conf/test.config
 * Minimal test profile using bundled test_data (from_pretty_csv entry).
 * Run: nextflow run main.nf -entry from_pretty_csv -profile test
 */

params {
    config_profile_name        = "test"
    config_profile_description = "Minimal test — from_pretty_csv with synthetic data"

    samplesheet  = "${projectDir}/test_data/samplesheet_fastq.csv"
    target_bed   = "${projectDir}/test_data/target.bed"
    bait_bed     = "${projectDir}/test_data/bait.bed"
    outdir       = "test_results"

    // Use small resource limits
    max_cpus    = 2
    max_memory  = "4.GB"
    max_time    = "1.h"
}

process {
    cpus   = 1
    memory = "2 GB"
    time   = "30 min"
}
