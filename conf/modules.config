/*
 * conf/modules.config
 * Per-process publishDir and ext.args configuration (nf-core style).
 */

process {

    // --- Upstream: FASTQ → BAM → callers ---

    withName: 'TRIM_FASTQ' {
        publishDir = [
            path: { "${params.outdir}/Trim/${meta?.sample_id ?: task.process}" },
            mode: params.publish_mode ?: 'copy',
            saveAs: { filename -> filename.endsWith('.fastq.gz') ? filename : null }
        ]
    }

    withName: 'ALIGN_BWA' {
        publishDir = [
            path: { "${params.outdir}/Alignments/${meta?.sample_id ?: task.process}" },
            mode: params.publish_mode ?: 'copy',
            pattern: '*.bam'
        ]
    }

    withName: 'MARK_DUPLICATES' {
        publishDir = [
            path: { "${params.outdir}/Alignments/${meta?.sample_id ?: task.process}" },
            mode: params.publish_mode ?: 'copy',
            pattern: '*.{bam,bai,metrics}'
        ]
    }

    withName: 'BQSR' {
        publishDir = [
            path: { "${params.outdir}/Alignments/BQSR/${meta?.sample_id ?: task.process}" },
            mode: params.publish_mode ?: 'copy',
            pattern: '*.bam'
        ]
    }

    withName: 'MUTECT' {
        publishDir = [
            path: { "${params.outdir}/Variants/MuTect/${meta?.sample_id ?: task.process}" },
            mode: params.publish_mode ?: 'copy',
            pattern: '*.vcf'
        ]
    }

    withName: 'VARSCAN' {
        publishDir = [
            path: { "${params.outdir}/Variants/VarScan/${meta?.sample_id ?: task.process}" },
            mode: params.publish_mode ?: 'copy',
            pattern: '*.vcf'
        ]
    }

    withName: 'MERGE_CALLERS_ANNOVAR' {
        publishDir = [
            path: { "${params.outdir}/Variants/Merged" },
            mode: params.publish_mode ?: 'copy'
        ]
    }

    withName: 'COLLECT_PRETTY' {
        publishDir = [
            path: "${params.outdir}/Variants/WXS",
            mode: params.publish_mode ?: 'copy',
            pattern: '*_variants_pretty.csv'
        ]
    }

    // --- Downstream: annotation → QC → reports ---

    withName: 'PARSE_PRETTY_CSV' {
        publishDir = [
            path: "${params.outdir}/Rdata",
            mode: params.publish_mode ?: 'copy',
            pattern: '*.rds'
        ]
    }

    withName: 'ANNOTATE_TARGET_BAIT' {
        publishDir = [
            path: "${params.outdir}/Rdata",
            mode: params.publish_mode ?: 'copy',
            pattern: '*.rds'
        ]
    }

    withName: 'SELECT_CANDIDATES' {
        publishDir = [
            path: "${params.outdir}/Rdata",
            mode: params.publish_mode ?: 'copy',
            pattern: '*.rds'
        ]
    }

    withName: 'ANNOTATE_FUNCTIONAL_DRUG' {
        publishDir = [
            path: "${params.outdir}/Rdata",
            mode: params.publish_mode ?: 'copy',
            pattern: '*.rds'
        ]
    }

    withName: 'QC_TERRITORIES' {
        publishDir = [
            path: "${params.outdir}/Results/Variant_calling/QCs",
            mode: params.publish_mode ?: 'copy'
        ]
    }

    withName: 'TMB' {
        publishDir = [
            [
                path: "${params.outdir}/Results/Variant_calling",
                mode: params.publish_mode ?: 'copy',
                pattern: '*.pdf'
            ],
            [
                path: "${params.outdir}/Tables",
                mode: params.publish_mode ?: 'copy',
                pattern: '*.csv'
            ]
        ]
    }

    withName: 'MAF_ANALYSIS' {
        publishDir = [
            path: "${params.outdir}/Results/Variant_calling",
            mode: params.publish_mode ?: 'copy'
        ]
    }

    withName: 'CLINICAL_REPORTS' {
        publishDir = [
            path: "${params.outdir}/Results/Variant_calling/CLINICAL_REPORTS",
            mode: params.publish_mode ?: 'copy'
        ]
    }

    withName: 'BENCHMARK_VARIANTS' {
        publishDir = [
            path: { "${params.outdir}/Benchmarking/${sample_id}" },
            mode: params.publish_mode ?: 'copy'
        ]
    }
}
