/*
 * Docker profile: run all processes inside the somatic-variants container.
 * Reference data (ref_fasta, dbsnp_vcf, cosmic_vcf, target_bed, bait_bed, annovar humandb)
 * must be mounted so they are at the same path inside the container.
 * Add a custom config with docker.runOptions = '-v /host/refs:/data/refs' then pass --ref_fasta /data/refs/genome.fa etc.
 */

// Require Docker so processes run inside the container (avoids "Unable to access jarfile" on host)
docker.enabled = true

// Default image (override with -with-docker somatic-variants:latest on the command line)
process {
  container = 'somatic-variants:latest'
  executor = 'local'
  cpus = 2
  memory = '4 GB'
  // Uncomment and set so refs are visible in the container:
  // docker.runOptions = '-v /path/to/your/refs:/data/refs'
}

// Tool paths inside the container (set when using -profile docker)
params {
  gatk_jar    = '/opt/somatic/jars/GenomeAnalysisTK.jar'
  picard_jar  = '/opt/somatic/jars/picard.jar'
  mutect_jar  = '/opt/somatic/jars/muTect-1.1.7.jar'
  varscan_jar = '/opt/somatic/jars/VarScan.v2.4.6.jar'
  annovar_basedir = '/opt/annovar'
}
