/*
 * Base process configuration for Somatic Variants Pipeline
 */

process {
  executor    = "local"
  maxRetries  = 1
  errorStrategy = "retry"
  maxForks    = 4

  withName: "PARSE_PRETTY_CSV" {
    cpus   = 1
    memory = "2 GB"
    time   = "10m"
  }

  withName: "ANNOTATE_TARGET_BAIT" {
    cpus   = 1
    memory = "4 GB"
    time   = "30m"
  }

  withName: "SELECT_CANDIDATES" {
    cpus   = 1
    memory = "4 GB"
    time   = "20m"
  }

  withName: "ANNOTATE_FUNCTIONAL_DRUG" {
    cpus   = 1
    memory = "8 GB"
    time   = "1h"
  }

  withName: "QC_TERRITORIES" {
    cpus   = 1
    memory = "4 GB"
    time   = "15m"
  }

  withName: "TMB" {
    cpus   = 1
    memory = "2 GB"
    time   = "10m"
  }

  withName: "MAF_ANALYSIS" {
    cpus   = 1
    memory = "2 GB"
    time   = "10m"
  }

  withName: "CLINICAL_REPORTS" {
    cpus   = 1
    memory = "4 GB"
    time   = "30m"
  }
}
