/*
 * conf/test_full.config
 * Full test profile for the complete from_fastq → downstream pipeline.
 * Requires real reference data; intended for CI environments with large storage.
 * Override file paths via -params-file or environment variables.
 */

params {
    config_profile_name        = "test_full"
    config_profile_description = "Full integration test — from_fastq (requires real reference data)"

    samplesheet        = "${projectDir}/test_data/samplesheet_fastq.csv"
    ref_fasta          = null   // override: path to hg38 reference FASTA
    bwa_index          = null
    dbsnp_vcf          = null
    cosmic_vcf         = null
    annovar_basedir    = null
    target_bed         = "${projectDir}/test_data/target.bed"
    bait_bed           = "${projectDir}/test_data/bait.bed"
    outdir             = "test_full_results"

    max_cpus    = 8
    max_memory  = "32.GB"
    max_time    = "6.h"
}
