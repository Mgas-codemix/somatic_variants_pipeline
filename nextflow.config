/*
 * Somatic Variants Pipeline - Nextflow configuration
 * Supports:
 *   - from_fastq: FASTQ -> BAM -> callers -> ANN OVAR -> pretty CSV (HaTSPiL-aligned upstream, stops at pretty.csv)
 *   - from_pretty_csv: pretty CSV -> downstream (Variants_Analysis-style QC, TMB, MAF, clinical reports)
 */

// Pipeline parameters (override with -c or -params-file)
params {
  // Input
  samplesheet           = null
  variants_dir          = null
  // Reference data (downstream)
  target_bed            = null
  bait_bed              = null
  ref_rdata_dir         = null
  false_cancer_genes     = null
  gene_categories_repo   = null
  acc_actionable_164     = null
  dgidb_tsv             = null
  // Upstream (from_fastq): reference and tools
  ref_fasta             = null
  bwa_index             = null
  dbsnp_vcf             = null
  cosmic_vcf            = null
  known_indels          = null
  annovar_basedir       = null
  annovar_buildver      = "hg38"
  adapter_r1            = "AGATCGGAAGAGCACACGTCTGAACTCCAGTCA"
  adapter_r2            = "AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT"
  // Upstream: tool paths (leave empty to use PATH)
  bwa                   = "bwa"
  samtools              = "samtools"
  java                  = "java"
  gatk_jar              = null
  picard_jar            = null
  mutect_jar            = null
  varscan_jar           = null
  cutadapt              = "cutadapt"
  fastqc                = "fastqc"
  seqtk                 = "seqtk"
  // Upstream: optional Strelka
  strelka_basedir       = null
  strelka_config        = null
  // Output
  outdir                = "./results"
  clinical_reports_dir   = "${params.outdir}/Variant_calling/CLINICAL_REPORTS"
  tmb_table_path        = "${params.outdir}/Tables/TMB.csv"
  // Run mode: from_pretty_csv | from_fastq | from_bam | from_vcf
  run_mode              = "from_pretty_csv"
  // Thresholds (Variants_Analysis document - downstream)
  min_freq              = 0.05
  min_dp                = 10
  tmb_ref_lines         = [1, 10, 100]
  // Upstream variant calling thresholds (HaTSPiL-aligned somatic calling)
  //
  // HaTSPiL upstream steps (mirrored by this pipeline):
  //   - Trim: cutadapt (Illumina adapters) + seqtk trimfq -b 5
  //   - Align: bwa mem
  //   - BAM processing: Picard AddOrReplaceReadGroups, MarkDuplicates; GATK BaseRecalibrator + PrintReads (BQSR)
  //   - Variant calling:
  //       * MuTect 1.x (ref_fasta, dbsnp_vcf, cosmic_vcf, tumor BAM)
  //       * VarScan2 mpileup2snp/mpileup2indel with --min-coverage, --min-var-freq, --p-value 1
  //   - Merge/filter (merge_callers_prepare_annovar.py):
  //       * Drop variants with depth < min_cov_position
  //       * Drop variants with allele frequency < min_allele_frequency
  //       * Track methods (MuTect/VarScan) per variant
  //   - ANNOVAR table_annovar:
  //       * -protocol refGene,snp138,cosmic70,clinvar_20160302,dbnsfp30a,cadd13
  //   - Collect pretty (collect_pretty.R):
  //       * Join multianno + variants on key
  //       * Write *_variants_pretty.csv with OUTCOL-like columns (id, Chr, Start, End, Ref, Alt, Func.refGene, Gene.refGene, GeneDetail.refGene,
  //         ExonicFunc.refGene, AAChange.refGene, snp138, cosmic70, CLINSIG, CADD13_PHRED, DP, FREQ, method)
  min_allele_frequency   = 0.01
  min_cov_position      = 10
  varscan_min_coverage_tumor = 10
  varscan_min_var_freq   = 0.05
  // Optional
  publish_mode          = "copy"
  skip_cutadapt         = false
  skip_fastqc           = false
}

// Load base config (process defaults, executor)
includeConfig "conf/base.config"

// Workflow entry
workflow {
  main_script = "main.nf"
}

// Profiles (override with -profile <name>)
profiles {
  standard { includeConfig "conf/base.config" }
  local    { includeConfig "conf/base.config"; process.executor = "local"; process.cpus = 2; process.memory = "4 GB" }
  slurm    { includeConfig "conf/base.config"; process.executor = "slurm"; process.clusterOptions = "-A project" }
  docker   {
    includeConfig "conf/base.config"
    includeConfig "conf/docker.config"
  }
}

// Per-process publishDir / ext.args (nf-core modules.config)
// Already loaded in conf/modules.config via includeConfig above if using profiles;
// include here too for direct runs without a profile:
// (only if not already included — Nextflow deduplicates)

// Additional profiles
profiles {
  singularity {
    includeConfig "conf/base.config"
    includeConfig "conf/singularity.config"
  }
  test      {
    includeConfig "conf/base.config"
    includeConfig "conf/test.config"
  }
  test_full {
    includeConfig "conf/base.config"
    includeConfig "conf/test_full.config"
  }
}

// Benchmarking parameters (opt-in: provide --truth_vcf to activate)
params {
  truth_vcf     = null
  confident_bed = null
  run_benchmark = false
}
