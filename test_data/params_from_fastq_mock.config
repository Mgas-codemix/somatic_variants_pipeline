// Example params for running from_fastq with test_data mock reference and FASTQs.
// Usage: nextflow run main.nf -entry from_fastq -c test_data/params_from_fastq_mock.config \
//          --picard_jar /path/to/picard.jar --gatk_jar /path/to/GenomeAnalysisTK.jar \
//          --mutect_jar /path/to/muTect.jar --varscan_jar /path/to/VarScan.jar
//
// Or with Docker: nextflow run main.nf -entry from_fastq -profile docker \
//   -c test_data/params_from_fastq_mock.config --ref_fasta /data/refs/ref.fa ...

params {
  samplesheet = "test_data/samplesheet_fastq.csv"
  target_bed  = "test_data/target.bed"
  bait_bed    = "test_data/bait.bed"
  ref_fasta   = "test_data/reference/ref.fa"
  dbsnp_vcf   = "test_data/reference/dbsnp.vcf"
  cosmic_vcf  = "test_data/reference/cosmic.vcf"
  outdir      = "results_from_fastq_mock"
}
